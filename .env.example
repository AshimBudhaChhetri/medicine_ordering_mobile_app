# Public backend URL used by the Expo mobile application.
# Do not add a trailing slash.
# Business APIs live directly under this URL.
#
# Example:
# https://example.trycloudflare.com

EXPO_PUBLIC_API_BASE_URL=

# EAS project id used to mint an Expo push token.
# Find it in the Expo dashboard, or run `eas project:info`.
EXPO_PUBLIC_EAS_PROJECT_ID=